<section class="contact section" id="contact">
   <div class="container">
      <div class="contact__header" data-animate="fade-up">
         <span class="section__subtitle">CONTACTANOS</span>
         <h2 class="section__title">Cotiza con nosotros</h2>
      </div>

      <div class="contact__container grid">
         <div class="contact__map" data-animate="fade-right">
            <div class="map-container">
               <iframe
                  src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d2796.0004447498504!2d-72.10259702372349!3d-45.510069671074724!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f100!3m2!1m1!2zNDXCsDMwJzM2LjMiUyA3MsKwMDYnMDAuMSJX!5e0!3m2!1ses!2scl!4v1766711720315!5m2!1ses!2scl"
                  width="100%"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
               >
               </iframe>
            </div>
         </div>

         <div class="contact__data">
            <form class="contact__form" id="contact-form" action="https://api.web3forms.com/submit" method="POST">
               <!-- Access Key de Web3Forms - Reemplaza con tu propia key de https://web3forms.com -->
               <input type="hidden" name="access_key" value="125f5222-ddf3-43c7-a640-4c6b968e0f9a" />
               
               <!-- Información adicional opcional -->
               <input type="hidden" name="subject" value="Nueva Consulta desde Racam Web" />
               <input type="hidden" name="from_name" value="Formulario Racam" />

               <div class="contact__form-group">
                  <input
                     type="text"
                     id="contact-name"
                     name="name"
                     class="contact__form-input"
                     placeholder="Tu nombre completo"
                     required
                  />
               </div>

               <div class="contact__form-group">
                  <input
                     type="email"
                     id="contact-email"
                     name="email"
                     class="contact__form-input"
                     placeholder="tu@email.com"
                     required
                  />
               </div>

               <div class="contact__form-group">
                  <input
                     type="tel"
                     id="contact-phone"
                     name="phone"
                     class="contact__form-input"
                     placeholder="+56 9 1234 5678"
                     required
                  />
               </div>

               <div class="contact__form-group">
                  <textarea
                     id="contact-message"
                     name="message"
                     class="contact__form-textarea"
                     placeholder="Describe brevemente tu consulta..."
                     rows="2"
                     required></textarea>
               </div>

               <!-- Honeypot para prevenir spam -->
               <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

               <!-- hCaptcha widget -->
               <div class="contact__form-group">
                  <div class="h-captcha" data-captcha="true"></div>
               </div>

               <button type="submit" class="contact__form-button">
                  Enviar
                  <i class="ri-send-plane-line"></i>
               </button>

               <p class="contact__form-message" id="form-message"></p>
            </form>
         </div>
      </div>
   </div>
</section>

<style>
   .contact__header {
      text-align: center;
      margin-bottom: 3rem;
   }

   .contact__description {
      color: var(--text-color-light);
      max-width: 600px;
      margin: 1rem auto 0;
      font-size: 1rem;
      line-height: 1.6;
   }

   .map-container {
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 250px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
   }

   .map-container:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
   }

   .map-container iframe {
      height: 100%;
   }

   .contact__form {
      background: var(--container-color);
      padding: 1.5rem;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
   }

   @media screen and (min-width: 768px) {
      .contact__form {
         padding: 2.5rem;
      }

      .map-container {
         min-height: 350px;
      }
   }

   .contact__form:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
   }

   .contact__form-group {
      margin-bottom: 1.5rem;
      animation: slideIn 0.5s ease forwards;
      opacity: 0;
   }

   .contact__form-group:nth-child(5) { animation-delay: 0.1s; }
   .contact__form-group:nth-child(6) { animation-delay: 0.2s; }
   .contact__form-group:nth-child(7) { animation-delay: 0.3s; }
   .contact__form-group:nth-child(8) { animation-delay: 0.4s; }
   .contact__form-group:nth-child(9) { animation-delay: 0.5s; }

   @keyframes slideIn {
      from {
         opacity: 0;
         transform: translateX(-20px);
      }
      to {
         opacity: 1;
         transform: translateX(0);
      }
   }

   /* Animaciones de entrada para la sección */
   [data-animate] {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s ease, transform 0.6s ease;
   }

   [data-animate].animate-in {
      opacity: 1;
      transform: translateY(0);
   }

   [data-animate="fade-right"] {
      transform: translateX(-50px);
   }

   [data-animate="fade-left"] {
      transform: translateX(50px);
   }

   [data-animate="fade-right"].animate-in,
   [data-animate="fade-left"].animate-in {
      transform: translateX(0);
   }

   .contact__form-button {
      transition: all 0.3s ease;
   }

   .contact__form-button:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
   }

   .contact__form-hint {
      display: block;
      margin-top: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-color-light);
      font-style: italic;
   }
</style>

<script is:inline>
   document.addEventListener('DOMContentLoaded', () => {
      // Animaciones de scroll
      const observerOptions = {
         threshold: 0.15,
         rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
         entries.forEach(entry => {
            if (entry.isIntersecting) {
               entry.target.classList.add('animate-in');
            }
         });
      }, observerOptions);

      document.querySelectorAll('[data-animate]').forEach(el => {
         observer.observe(el);
      });

      // Formulario
      const form = document.getElementById('contact-form');
      const submitButton = form.querySelector('.contact__form-button');
      const formMessage = document.getElementById('form-message');
      const buttonText = submitButton.childNodes[0];
      const buttonIcon = submitButton.querySelector('i');

      form.addEventListener('submit', async (e) => {
         e.preventDefault();

         // Validar hCaptcha
         const hcaptchaResponse = document.querySelector('.h-captcha textarea')?.value;
         if (!hcaptchaResponse) {
            formMessage.textContent = 'Por favor, completa el captcha para continuar.';
            formMessage.className = 'contact__form-message error';
            setTimeout(() => {
               formMessage.textContent = '';
            }, 3000);
            return;
         }

         // Deshabilitar el botón y mostrar estado de carga
         submitButton.disabled = true;
         const originalText = buttonText.textContent;
         buttonText.textContent = 'Enviando...';
         buttonIcon.className = 'ri-loader-4-line';
         buttonIcon.style.animation = 'spin 1s linear infinite';
         formMessage.textContent = '';
         formMessage.className = 'contact__form-message';

         try {
            const formData = new FormData(form);
            const response = await fetch('https://api.web3forms.com/submit', {
               method: 'POST',
               body: formData
            });

            const result = await response.json();
            
            // Debug: mostrar respuesta completa
            console.log('Web3Forms response:', result);

            if (result.success) {
               // Mostrar mensaje de éxito
               buttonText.textContent = '¡Enviado!';
               buttonIcon.className = 'ri-check-line';
               buttonIcon.style.animation = 'none';
               
               formMessage.textContent = '¡Gracias por tu consulta! Te contactaremos pronto.';
               formMessage.className = 'contact__form-message success';

               // Limpiar el formulario
               form.reset();
               
               // Resetear hCaptcha
               if (typeof hcaptcha !== 'undefined') {
                  hcaptcha.reset();
               }

               // Restaurar el botón después de 5 segundos
               setTimeout(() => {
                  buttonText.textContent = originalText;
                  buttonIcon.className = 'ri-send-plane-line';
                  submitButton.disabled = false;
                  formMessage.textContent = '';
               }, 5000);
            } else {
               throw new Error(result.message || 'Error al enviar el formulario');
            }
         } catch (error) {
            // Mostrar mensaje de error
            buttonText.textContent = 'Error';
            buttonIcon.className = 'ri-error-warning-line';
            buttonIcon.style.animation = 'none';

            formMessage.textContent = 'Error al enviar el mensaje. Por favor, intenta nuevamente o contáctanos directamente.';
            formMessage.className = 'contact__form-message error';

            // Restaurar el botón después de 5 segundos
            setTimeout(() => {
               buttonText.textContent = originalText;
               buttonIcon.className = 'ri-send-plane-line';
               submitButton.disabled = false;
            }, 5000);
         }
      });
   });

   // Agregar animación de spin para el loader
   const style = document.createElement('style');
   style.textContent = `
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .contact__form-message {
      margin-top: 1rem;
      padding: 1rem;
      border-radius: 0.5rem;
      text-align: center;
      font-weight: 500;
      display: none;
    }
    .contact__form-message.success {
      display: block;
      background-color: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
    }
    .contact__form-message.error {
      display: block;
      background-color: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
    }
  `;
   document.head.appendChild(style);
</script>
