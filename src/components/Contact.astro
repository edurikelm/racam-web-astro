<section class="contact section" id="contact">
   <div class="container">
      <span class="section__subtitle">CONTACTANOS</span>
      <h2 class="section__title">Envianos un mensaje</h2>

      <div class="contact__container grid">
         <div class="contact__map">
            <iframe
               src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d124419.54534508!2d-77.11773049999999!3d-12.046374!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105c5f619ee3ec7%3A0x14206cb9cc452e4a!2sLima%2C%20Peru!5e0!3m2!1sen!2s!4v1234567890123!5m2!1sen!2s"
               width="100%"
               height="400"
               style="border:0;"
               allowfullscreen=""
               loading="lazy"
               referrerpolicy="no-referrer-when-downgrade"
            >
            </iframe>
         </div>

         <div class="contact__data">
            <form class="contact__form" id="contact-form">
               <div class="contact__form-group">
                  <label for="contact-email" class="contact__form-label">
                     <i class="ri-mail-line"></i> Correo Electrónico
                  </label>
                  <input
                     type="email"
                     id="contact-email"
                     name="email"
                     class="contact__form-input"
                     placeholder="tu@email.com"
                     required
                  />
               </div>

               <div class="contact__form-group">
                  <label for="contact-phone" class="contact__form-label">
                     <i class="ri-phone-line"></i> Teléfono
                  </label>
                  <input
                     type="tel"
                     id="contact-phone"
                     name="phone"
                     class="contact__form-input"
                     placeholder="+51 999 999 999"
                     required
                  />
               </div>

               <div class="contact__form-group">
                  <label for="contact-message" class="contact__form-label">
                     <i class="ri-message-3-line"></i> Consulta
                  </label>
                  <textarea
                     id="contact-message"
                     name="message"
                     class="contact__form-textarea"
                     placeholder="Describe brevemente tu consulta..."
                     rows="1"
                     required></textarea>
               </div>

               <button type="submit" class="contact__form-button">
                  Enviar Consulta
                  <i class="ri-send-plane-line"></i>
               </button>
            </form>
         </div>
      </div>
   </div>
</section>

<script is:inline>
   document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form');
      const submitButton = form.querySelector('.contact__form-button');
      const buttonText = submitButton.childNodes[0];
      const buttonIcon = submitButton.querySelector('i');

      form.addEventListener('submit', async (e) => {
         e.preventDefault();

         // Obtener los datos del formulario
         const formData = new FormData(form);
         const data = {
            email: formData.get('email'),
            phone: formData.get('phone'),
            message: formData.get('message'),
         };

         // Deshabilitar el botón y mostrar estado de carga
         submitButton.disabled = true;
         const originalText = buttonText.textContent;
         buttonText.textContent = 'Enviando...';
         buttonIcon.className = 'ri-loader-4-line';
         buttonIcon.style.animation = 'spin 1s linear infinite';

         try {
            // Enviar los datos al API endpoint
            const response = await fetch('/api/contact', {
               method: 'POST',
               headers: {
                  'Content-Type': 'application/json',
               },
               body: JSON.stringify(data),
            });

            const result = await response.json();

            if (result.success) {
               // Mostrar mensaje de éxito
               buttonText.textContent = '¡Enviado!';
               buttonIcon.className = 'ri-check-line';
               buttonIcon.style.animation = 'none';

               // Limpiar el formulario
               form.reset();

               // Mostrar alerta de éxito
               alert(result.message);

               // Restaurar el botón después de 3 segundos
               setTimeout(() => {
                  buttonText.textContent = originalText;
                  buttonIcon.className = 'ri-send-plane-line';
                  submitButton.disabled = false;
               }, 3000);
            } else {
               throw new Error(result.message);
            }
         } catch (error) {
            // Mostrar mensaje de error
            buttonText.textContent = 'Error';
            buttonIcon.className = 'ri-error-warning-line';
            buttonIcon.style.animation = 'none';

            alert(
               error instanceof Error
                  ? error.message
                  : 'Error al enviar el mensaje. Por favor, intenta nuevamente.',
            );

            // Restaurar el botón después de 3 segundos
            setTimeout(() => {
               buttonText.textContent = originalText;
               buttonIcon.className = 'ri-send-plane-line';
               submitButton.disabled = false;
            }, 3000);
         }
      });
   });

   // Agregar animación de spin para el loader
   const style = document.createElement('style');
   style.textContent = `
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
  `;
   document.head.appendChild(style);
</script>
