---
import { galleryData } from '../data/gallery.js';

// Extraer categorías únicas y ordenarlas
const uniqueCategories = [...new Set(galleryData.map((photo) => photo.categoria))].sort();

// Función para formatear el nombre de la categoría
const formatCategoryName = (category: string): string => {
  return category
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
};
---

<section class="gallery-section section" id="gallery">
  <div class="container">
    <div class="gallery-header">
      <h2 class="section__title">
        Galería de <span>Trabajos</span>
      </h2>
      <p class="gallery-subtitle">
        Explora nuestra colección de proyectos con transiciones elegantes
      </p>
    </div>

    <div class="gallery-filter-buttons">
      <button class="gallery-filter-btn active" data-filter="all">Todas</button>
      {
        uniqueCategories.map((category) => (
          <button class="gallery-filter-btn" data-filter={category}>
            {formatCategoryName(category)}
          </button>
        ))
      }
    </div>

    <div class="gallery-grid" id="gallery-grid">
      {
        galleryData.map((photo) => (
          <div class="gallery-photo-card" data-category={photo.categoria}>
            <img
              src={photo.image}
              alt={photo.title}
              class="gallery-photo-image"
            />
            <div class="gallery-photo-overlay">
              <h3 class="gallery-photo-title">{photo.title}</h3>
              <p class="gallery-photo-description">{photo.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
