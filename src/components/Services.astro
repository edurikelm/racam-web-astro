---
import { services } from '../data/services.js';
---

<section class="services section" id="services">
  <div class="services__container container grid">
    <div class="services__data">
      <div>
        <span class="section__subtitle">NUESTROS SERVICIOS</span>
        <h2 class="section__title">
          Soluciones Eléctricas Integrales y Especializadas
        </h2>
      </div>

      <p class="services__description">
        Ofrecemos soluciones eléctricas completas con calidad, seguridad y
        eficiencia en cada proyecto.
      </p>

      <a href="#contact" class="button">Contacto</a>
    </div>

    <div class="services__section">
        {
          services.map((service) => (
            <article class="services__card">
              <div class="services__content">
                <div class="services__icon">
                  <i class={service.icon} />
                </div>
                <h3 class="services__title">{service.title}</h3>

                <ul class="services__list">
                  {service.items.map((item) => (
                    <li class="services__item">
                      <i class="ri-checkbox-circle-line" />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
    </div>
</section>
